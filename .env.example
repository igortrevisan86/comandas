# ==============================================================================
# CONFIGURAÇÃO DE AMBIENTE - SISTEMA DE COMANDAS PARA RESTAURANTE
# ==============================================================================
# Copie este arquivo para .env antes de executar o sistema:
# copy .env.example .env

# --- Configurações do Banco de Dados PostgreSQL ---
POSTGRES_DB=comandas_db
POSTGRES_USER=comandas_admin
# ATENÇÃO: Altere esta senha para uma senha forte em produção!
POSTGRES_PASSWORD=SenhaSeguraComandas2026!
POSTGRES_HOST=db
POSTGRES_PORT=5432

# URL completa para SQLAlchemy (utilizada internamente pelo container backend)
DATABASE_URL=postgresql+psycopg2://comandas_admin:SenhaSeguraComandas2026!@db:5432/comandas_db

# --- Segurança e Autenticação JWT ---
# Gere uma chave segura com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=e4f8c9b201a4e5f76b91c3d82a170564e9a8f7c6b5d4e3f2a10987654321abcd
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- Primeiro Usuário Administrador (Criado automaticamente se o banco estiver vazio) ---
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=Admin@Comandas2026!
ADMIN_INITIAL_NAME=Administrador do Sistema

# --- Configuração de Rede e Servidor HTTP ---
# Porta pública exposta pelo Nginx no Windows e na rede local
HTTP_PORT=8080

# Origens permitidas no CORS (separadas por vírgula)
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
